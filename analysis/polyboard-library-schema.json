  "validationConstraints": [
    {
      "id": "stable-reference-resolution",
      "kind": "proposed-rokadex",
      "rule": "Every referenced entity must resolve to a known identity and explicit version; display names are not identities."
    },
    {
      "id": "numeric-stock-thickness",
      "kind": "proposed-rokadex",
      "rule": "Use numeric stock thickness in millimetres; never infer it from generic material names or suffixes."
    },
    {
      "id": "display-and-production-separation",
      "kind": "proposed-rokadex",
      "rule": "Visual appearance does not establish real stock availability, machining compatibility or approval."
