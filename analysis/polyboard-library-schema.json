    {
      "id": "two-stage-workflow",
      "manual_pages": [
        7,
        9,
        11,
        12
      ],
      "statement": "Visual design materials must be associated with real manufacturable stock and an appropriate manufacturing method before production."
    },
    {
      "id": "material-role-and-grouping",
      "manual_pages": [
        10,
        11,
        12,
        43
      ],
      "statement": "Role-based Quick Design materials and grouped generic/supplier materials serve different design and cutting-list needs."
    },
    {
      "id": "names-not-complete-parameter-data",
      "manual_pages": [
        5,
        6,
        12
      ],
      "statement": "Abbreviated names do not contain all parameters; adjacent four-digit material codes may represent the same thickness with a different colour."
    },
    {
      "id": "display-only-elements",
      "manual_pages": [
        12
      ],
      "statement": "The described library includes display-only material entries intended to be omitted from cutting lists."
    },
    {
      "id": "bars-are-linear-stock",
      "manual_pages": [
        15,
        16,
        17,
        19
      ],
      "statement": "Bar material has a cross-section, is purchased in lengths and is used with frame/structure rules."
    },
    {
      "id": "local-versus-global-structure",
      "manual_pages": [
        20,
        21,
        60
      ],
      "statement": "Applying a stored structure to a panel and applying an assembled-pieces sub-method to a cabinet have different scopes."
    },
    {
      "id": "hardware-versus-placement",
      "manual_pages": [
        24,
        25,
        26,
        27,
        28,
        32,
        50,
        51
      ],
      "statement": "A hardware definition and the rule deciding its placement are separate library concepts, connected by fitting links."
    },
    {
      "id": "single-panel-hardware",
      "manual_pages": [
        23,
        33,
        34
      ],
      "statement": "Single-panel fittings differ from fittings connecting two panels and include face/depth information."
    },
    {
      "id": "method-is-composite",
      "manual_pages": [
        35,
        36,
        37
      ],
      "statement": "A manufacturing method groups sub-methods; individual sub-methods can also be applied separately."
    },
    {
      "id": "method-replacement-scope",
      "manual_pages": [
        36
      ],
      "statement": "Applying a method can replace previous settings; the manual discusses applying to new components where appropriate."
    },
    {
      "id": "priorities-drive-geometry",
      "manual_pages": [
        38,
        39,
        40,
        41,
        42,
        58,
        59
      ],
      "statement": "Panel priorities, setbacks and groove settings participate in carcass and drawer construction."
